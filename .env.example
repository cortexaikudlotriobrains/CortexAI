# ============================================
# Component boundary controls
# ============================================
SERVE_FRONTEND=true
FRONTEND_DIR=frontend-react/dist
# Frontend runtime config (served at GET /runtime-config.js when SERVE_FRONTEND=true)
# Leave blank to use request origin automatically.
FRONTEND_RUNTIME_API_BASE=
# Optional explicit browser-side override for local dev bootstrap.
# If unset, frontend inherits ENABLE_DEV_SESSION_LOGIN behavior.
# FRONTEND_RUNTIME_ENABLE_DEV_SESSION_LOGIN=false
# Optional browser-visible token sent as X-Dev-Login-Token by frontend bootstrap.
# FRONTEND_RUNTIME_DEV_SESSION_LOGIN_TOKEN=

# ============================================
# Provider and model selection
# ============================================
MODEL_TYPE=openai

OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_OPENAI_MODEL=gpt-4o-mini
# Model used only by the on-demand Cortex Analysis layer for Compare results.
CORTEX_ANALYSIS_MODEL=gpt-5.4-mini

GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
DEFAULT_GEMINI_MODEL=gemini-2.5-flash-lite

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEFAULT_DEEPSEEK_MODEL=deepseek-chat

GROK_API_KEY=your_grok_api_key_here

# Claude API Configuration (required if MODEL_TYPE=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_CLAUDE_MODEL=claude-sonnet-4-5

# Amazon Cognito (Gmail / Google sign-in)
# Optional. When set, frontend can use "Sign in with Google"; API accepts Bearer ID token or X-API-Key.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_DOMAIN=
# Callback URL for authorization code flow (must match Cognito app client). If unset, uses request base + /v1/auth/callback.
COGNITO_REDIRECT_URI=
# Verify TLS certificates for Cognito JWKS and token endpoints. Keep true outside controlled local troubleshooting.
COGNITO_SSL_VERIFY=true
# Required for token exchange if app client has a secret
# COGNITO_CLIENT_SECRET=
# Where to redirect after successful login (default /index.html). Use full URL if frontend is on another origin (e.g. CloudFront).
# COGNITO_SUCCESS_REDIRECT_URI=https://d25xyr8ffdpyvr.cloudfront.net/index.html

# Reverse proxy and session-cookie behavior
# Trust forwarded request metadata behind CloudFront/ALB. Set false when no trusted upstream proxy is present.
ENABLE_PROXY_HEADERS=true
# Comma-separated trusted proxy IPs/CIDRs. "*" trusts all upstreams; narrow this for directly reachable production services.
TRUSTED_PROXY_IPS=*
# Leave unset to auto-detect HTTPS from the request scheme; uncomment with true/false for an explicit policy.
# SESSION_COOKIE_SECURE=
# Persistent cookie lifetime in seconds. 0 uses a browser-session cookie.
SESSION_MAX_AGE_SECONDS=604800

# Local dev session bootstrap helper (disabled by default; never enable in production)
ENABLE_DEV_SESSION_LOGIN=false
# Optional shared secret header expected by POST /v1/auth/dev-login as X-Dev-Login-Token
# DEV_SESSION_LOGIN_TOKEN=

# For Grok models (e.g., grok-4-latest)
# grok-4-latest: Latest Grok model with advanced reasoning capabilities
DEFAULT_GROK_MODEL=grok-4-latest

# ============================================
# Chat/routing/logging behavior
# ============================================
MAX_CONTEXT_MESSAGES=20
COMPARE_MODE=false
RESEARCH_MODE=auto
ROUTING_MODE=smart
ROUTING_DEBUG_JSON=false
# Provider-aware Quick/Balanced/Deep/Extended budgets. False restores Quick/2K execution.
GENERATION_BUDGET_POLICY_ENABLED=true

# Cache-aware accounting starts in shadow mode: calculate both totals, settle legacy.
CACHE_AWARE_CREDIT_CALCULATION_ENABLED=true
CACHE_AWARE_CREDIT_SETTLEMENT_ENABLED=false

# Privacy-safe provider cache affinity. Use a long random secret in deployed environments.
CACHE_KEY_SECRET=
CACHE_FRIENDLY_PROMPT_ORDERING_ENABLED=false
OPENAI_PROMPT_CACHE_ENABLED=false
OPENAI_EXTENDED_PROMPT_CACHE_ENABLED=false
CLAUDE_PROMPT_CACHE_ENABLED=false
GROK_PROMPT_CACHE_ENABLED=false

# Independent reuse and context/generation rollout controls.
PERSISTENT_RESEARCH_REUSE_ENABLED=false
PROMPT_OPTIMIZATION_REUSE_ENABLED=false
CORTEX_ANALYSIS_REUSE_ENABLED=false
CREDIT_AWARE_GENERATION_BUDGET_ENABLED=false
CONTEXT_COMPACTION_ENABLED=false
CONTEXT_COMPACTION_THRESHOLD_RATIO=0.5
CONTEXT_COMPACTION_USABLE_WINDOW_TOKENS=40000
CONTEXT_COMPACTION_SUMMARY_CHARS=8000

# Streaming resilience: backend/API setting used by chat + compare streams.
# Keep this explicitly set in production; 0 disables heartbeat events.
STREAM_HEARTBEAT_INTERVAL_SECONDS=15

LOG_LEVEL=INFO
LOG_DESTINATION=both
LOG_CONSOLE_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_NOISY_LIBRARIES_LEVEL=WARNING
# Backward compatibility only: if LOG_DESTINATION is unset, LOG_TO_CONSOLE=true implies LOG_DESTINATION=both
# LOG_TO_CONSOLE=false
ROUTING_DEBUG=false

# ============================================
# API key auth + unmapped-key persistence policy
# ============================================
API_KEYS=dev-key-1,dev-key-2
# Required only for encrypted BYOK storage and retrieval. Use a long random secret.
MASTER_KEY=
AUTO_REGISTER_UNMAPPED_API_KEYS=false
ALLOW_UNMAPPED_API_KEY_PERSIST=false
API_KEY_FALLBACK_USER_EMAIL=api@cortexai.local
API_KEY_FALLBACK_USER_NAME=API Service User

# ============================================
# Web research + prompt optimization
# ============================================
TAVILY_API_KEY=your_tavily_api_key_here
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_TTL_SECONDS=900
TAVILY_NETWORK_DIAGNOSTICS_HOST=api.tavily.com
TAVILY_NETWORK_DIAGNOSTICS_PORT=443
TAVILY_NETWORK_DIAGNOSTICS_INTERVAL_SECONDS=300
TAVILY_NETWORK_DIAGNOSTICS_TIMEOUT_SECONDS=2

ENABLE_PROMPT_OPTIMIZATION=false
ENABLE_ORCHESTRATOR_PROMPT_OPTIMIZATION=false
PROMPT_OPTIMIZER_PROVIDER=gemini
PROMPT_OPTIMIZER_MODEL=gemini-2.5-flash-lite
PROMPT_OPTIMIZER_GEMINI_MODEL=gemini-2.5-flash-lite
PROMPT_OPTIMIZER_TIMEOUT_MS=5000
PROMPT_OPTIMIZER_ROUTE_MAX_RETRIES=2
PROMPT_OPTIMIZER_MAX_OUTPUT_TOKENS=450
PROMPT_OPTIMIZER_TEMPERATURE=0.2
PROMPT_OPTIMIZER_MAX_RETRIES=3

# ============================================
# PostgreSQL runtime
# ============================================
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cortexai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_SCHEMA=public

# ============================================
# B2C subscription resolution
# ============================================
# Keep false until the verified Stripe webhook endpoint is configured and tested.
# Controls Stripe Checkout, Portal and webhooks only. When false, Cortex-issued
# Plus/Pro grants still provide entitlements; users without a valid grant are Free.
BILLING_ENABLED=false
# Grace window used when a past_due snapshot has no explicit grace_until value.
SUBSCRIPTION_PAYMENT_GRACE_DAYS=3
# Required only when BILLING_ENABLED=true. Values remain server-side.
STRIPE_SECRET_KEY=
# Signing secret for this exact webhook endpoint (Dashboard and Stripe CLI secrets differ).
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://127.0.0.1:5173/account/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://127.0.0.1:5173/pricing?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://127.0.0.1:5173/account/billing
# Optional. Leave unset to use the API version pinned by the Stripe SDK.
# STRIPE_API_VERSION=2026-06-24.dahlia
# Local development only: free|plus|pro|unrestricted. Ignored when BILLING_ENABLED=true and outside
# APP_ENV/ENVIRONMENT/ENV=local|dev|development. Never use this in production.
# DEV_SUBSCRIPTION_PLAN=pro
# The unrestricted profile also requires an explicit bypass flag. Prefer
# `python run_app.py --subscription-plan unrestricted`, which sets both safely.
# DEV_SUBSCRIPTION_BYPASS_ENABLED=false
# Automatic unified-credit reservation maintenance (PostgreSQL runtime).
ENABLE_BILLING_RESERVATION_CLEANUP_WORKER=true
BILLING_RESERVATION_CLEANUP_INTERVAL_SECONDS=300
BILLING_RESERVATION_STALE_AFTER_SECONDS=1800
BILLING_RESERVATION_HEARTBEAT_INTERVAL_SECONDS=60

# ============================================
# Attachments / object storage
# ============================================
ENABLE_ATTACHMENTS=true
# Direct browser-to-S3 rollout is opt-in. React reads both flags through
# /runtime-config.js and uses the legacy batch path when direct mode is off.
# Keep proxy compatibility on until every deployed client supports direct mode.
ATTACHMENTS_DIRECT_UPLOAD_ENABLED=false
ATTACHMENTS_LEGACY_PROXY_UPLOAD_ENABLED=true
ATTACHMENTS_PRESIGN_TTL_SECONDS=300
ATTACHMENTS_UPLOAD_INTENT_TTL_MINUTES=30
ATTACHMENTS_FILE_TTL_HOURS=168
ATTACHMENTS_SYNC_INGEST_MAX_BYTES=2097152
ATTACHMENTS_SYNC_INGEST_TIMEOUT_SECONDS=10
# Platform ceilings; the backend applies the stricter plan/provider limit.
ATTACHMENTS_MAX_FILES_PER_REQUEST=5
ATTACHMENTS_MAX_FILE_BYTES=20971520
ATTACHMENTS_OBJECT_STORAGE_BACKEND=s3
ATTACHMENTS_S3_BUCKET=your-bucket-name
ATTACHMENTS_S3_REGION=us-east-1
# Leave endpoint blank for AWS S3. Set endpoint plus path style for MinIO/local S3.
ATTACHMENTS_S3_ENDPOINT_URL=
# Leave credentials blank in production so boto3 uses the EC2/task workload role.
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
ATTACHMENTS_S3_SESSION_TOKEN=
ATTACHMENTS_S3_USE_SSL=true
ATTACHMENTS_S3_FORCE_PATH_STYLE=false
ATTACHMENTS_S3_KEY_PREFIX=attachments
# Leave both blank to use bucket default encryption. Set AES256 or aws:kms only
# when the bucket policy requires explicit encryption fields on every upload.
ATTACHMENTS_S3_SERVER_SIDE_ENCRYPTION=
ATTACHMENTS_S3_SSE_KMS_KEY_ID=
# Required to remove abandoned intents, expired files, and user-deleted files.
# Production must run exactly one effective cleanup worker/service per queue.
ENABLE_ATTACHMENTS_CLEANUP_WORKER=false
ATTACHMENTS_CLEANUP_INTERVAL_SECONDS=300
ATTACHMENTS_CLEANUP_BATCH_SIZE=200
ATTACHMENTS_CLEANUP_MAX_ATTEMPTS=8
ATTACHMENTS_CLEANUP_RETRY_BACKOFF_SECONDS=60

# ============================================
# CortexAI Work (durable Managed Agent mode)
# ============================================
# Master UI/API flag. Keep false until the migration, provider, network, and
# subscription gates in docs/runbooks/cortex-work.md are complete.
CORTEX_WORK_ENABLED=false
CORTEX_WORK_AGENT_PROVIDER=anthropic_managed_agents
ANTHROPIC_MANAGED_AGENT_ID=
ANTHROPIC_MANAGED_ENVIRONMENT_ID=
# Provisioning-only input for config/work_agent.yaml. The runtime bills from the
# model in the retrieved Managed Agent session snapshot, never from this value.
ANTHROPIC_MANAGED_AGENT_MODEL=claude-haiku-4-5
# Default is 1,000,000 credits ($1.00) and is clamped to the user's plan limit.
CORTEX_WORK_DEFAULT_CREDIT_BUDGET=1000000
CORTEX_WORK_DEFAULT_OUTPUT_TOKENS=40000
CORTEX_WORK_OUTPUT_FINALIZE_TOKENS=32000
CORTEX_WORK_RECONCILER_ENABLED=true
CORTEX_WORK_RECONCILER_INTERVAL_SECONDS=2
CORTEX_WORK_SYNC_INTERVAL_SECONDS=2
CORTEX_WORK_SSE_HEARTBEAT_SECONDS=15
CORTEX_WORK_APPROVAL_TIMEOUT_SECONDS=86400

# Independent rollout gates. They have no effect while CORTEX_WORK_ENABLED=false.
CORTEX_WORK_MCP_ENABLED=false
CORTEX_WORK_ACTION_TOOLS_ENABLED=false
CORTEX_WORK_ARTIFACT_IMPORT_ENABLED=false
CORTEX_WORK_WEB_ENABLED=false

# AWS Secrets Manager path prefix used for OAuth connector tokens. The EC2/task
# workload role needs scoped CreateSecret/PutSecretValue permission for this prefix.
CORTEX_WORK_CONNECTOR_SECRET_PREFIX=cortex/work/connectors

# Repeat this block for GOOGLE_DRIVE, GMAIL, SLACK, JIRA, NOTION, and
# MICROSOFT_365. Verified connectors are operator-configured remote MCP services.
CORTEX_WORK_CONNECTOR_GITHUB_MCP_URL=
CORTEX_WORK_CONNECTOR_GITHUB_OAUTH_AUTHORIZATION_URL=
CORTEX_WORK_CONNECTOR_GITHUB_OAUTH_TOKEN_URL=
CORTEX_WORK_CONNECTOR_GITHUB_OAUTH_CLIENT_ID=
CORTEX_WORK_CONNECTOR_GITHUB_OAUTH_CLIENT_SECRET=
CORTEX_WORK_CONNECTOR_GITHUB_OAUTH_REDIRECT_URI=
CORTEX_WORK_CONNECTOR_GITHUB_OAUTH_SCOPE=
# Provider-side vault that Managed Agents uses when mounting this connector.
CORTEX_WORK_CONNECTOR_GITHUB_PROVIDER_VAULT_ID=

# Explicit local runtime label. Enable dev login above only on a trusted local machine.
APP_ENV=local
